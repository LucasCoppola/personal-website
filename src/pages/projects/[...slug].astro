---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import BackToPrev from "@components/BackToPrev.astro";
import DatabasePipeline from "@components/DatabasePipeline.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (left, right) => right.data.date.valueOf() - left.data.date.valueOf(),
  );

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: project,
  }));
}

type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content } = await project.render();
const hasProjectMedia = Boolean(project.data.video || project.data.embedYT);
---

<PageLayout title={project.data.title} description={project.data.description}>
  <Container>
    <article class="project-detail project-document-layout">
      <aside class="project-document-sidebar">
        <BackToPrev href="/projects">Back to projects</BackToPrev>

        <div class="project-document-title">
          <h1>{project.data.title}</h1>
          <p>{project.data.description}</p>
        </div>

        <div class="project-detail-meta">
          <span>Technologies</span>
          <p>{project.data.technologies.join(" · ")}</p>
        </div>

        {(project.data.URL || project.data.githubURL) && (
          <nav class="project-detail-links" aria-label="Project links">
            {project.data.URL && <a href={project.data.URL} target="_blank" rel="noreferrer">Live project ↗</a>}
            {project.data.githubURL && <a href={project.data.githubURL} target="_blank" rel="noreferrer">GitHub ↗</a>}
          </nav>
        )}
      </aside>

      <div class="project-document-content">
        {project.data.video && (
          <video
            class="project-detail-media"
            poster={project.data.videoPoster}
            aria-label={`${project.data.title} product demonstration`}
            autoplay
            muted
            loop
            playsinline
            controls
            preload="metadata"
          >
            {project.data.videoWebm && <source src={project.data.videoWebm} type="video/webm" />}
            <source src={project.data.video} type="video/mp4" />
            Your browser does not support HTML video.
          </video>
        )}

        {!project.data.video && project.data.embedYT && (
          <iframe
            class="project-detail-media"
            src={project.data.embedYT}
            title={`${project.data.title} demonstration`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen>
          </iframe>
        )}

        {!hasProjectMedia && (
          <div class="project-detail-pipeline">
            <DatabasePipeline />
          </div>
        )}

        <div class="project-detail-prose">
          <Content />
        </div>
      </div>
    </article>
  </Container>
</PageLayout>
