---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const projects = (await getCollection("projects")).sort(
  (left, right) => left.data.order - right.data.order,
);

const workEntries = (await getCollection("work")).sort(
  (left, right) => right.data.dateStart.valueOf() - left.data.dateStart.valueOf(),
);

const work = await Promise.all(
  workEntries.map(async (entry) => {
    const { Content } = await entry.render();
    return { ...entry, Content };
  }),
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <section class="home-intro">
      <h1>Hi, I'm<br />Lucas Coppola</h1>
      <article class="intro-copy">
        <p>
          I'm a <b>Full Stack developer</b> with a focus on backend development.
          I love to build things and solve problems, I enjoy web development
          and do most of my work in the terminal.
        </p>

        <p>Besides coding, I have a strong interest in strength sports and training,
          which led me to create <Link href="/projects/project-1">Lift.</Link>
        </p>

        <p>
          Most of my experience is in the <strong>Javascript</strong> ecosystem, especially
          in backend development with <strong>Typescript</strong> and <strong>Node.js</strong>,
          utilizing SQL databases like <strong>PostgreSQL</strong>, <strong>MySQL</strong> and <strong>SQLite</strong>.
          <br />
          I also work with frontend technologies like <strong>React</strong> and <strong>Next.js</strong>.
        </p>
      </article>
    </section>

    <section class="portfolio-section" aria-labelledby="work-heading">
      <div class="section-heading">
        <h2 id="work-heading">Work Experience</h2>
        <span>2023—Present</span>
      </div>
      <ol class="work-list">
        {work.map((entry) => (
          <li class="work-row">
            <div class="work-date">{dateRange(entry.data.dateStart, entry.data.dateEnd)}</div>
            <div class="work-position">
              <h3>{entry.data.company}</h3>
              <div>{entry.data.role}</div>
            </div>
            <div class="work-copy">
              <entry.Content />
              <div class="technology-list">{entry.data.technologies.join(" · ")}</div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="portfolio-section" aria-labelledby="projects-heading">
      <div class="section-heading">
        <h2 id="projects-heading">Projects</h2>
        <Link href="/projects">See all projects</Link>
      </div>
      <div class="project-showcase">
        {projects.slice(0, 2).map((project, index) => (
          <ArrowCard entry={project} index={index + 1} variant="featured" />
        ))}
        {projects[2] && <ArrowCard entry={projects[2]} index={3} variant="technical" />}
        <div class="compact-project-grid">
          {projects.slice(3).map((project, index) => (
            <ArrowCard entry={project} index={index + 4} variant="compact" />
          ))}
        </div>
      </div>
    </section>

    <section class="connect-section" aria-labelledby="connect-heading">
      <div>
        <h2 id="connect-heading">Let's Connect</h2>
        <p>
          If you want to get in touch with me about something or just to say hi,
          reach out on social media or send me an email.
        </p>
      </div>
      <div class="connect-links">
        {SOCIALS.map((social) => (
          <a href={social.HREF} target="_blank" rel="noreferrer" aria-label={`${SITE.NAME} on ${social.NAME}`}>
            {social.NAME}
          </a>
        ))}
        <button id="copy-email" type="button" data-email={SITE.EMAIL} data-copied="false">
          <span data-copy-label>Email</span>
          <span class="copy-icon-stack" aria-hidden="true">
            <svg class="copy-icon" viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg>
            <svg class="check-icon" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"></path></svg>
          </span>
        </button>
      </div>
    </section>
  </Container>
</PageLayout>

<script>
  function initializeEmailCopy() {
    const copyButton = document.querySelector<HTMLButtonElement>("#copy-email");
    if (!copyButton || copyButton.dataset.initialized) return;

    copyButton.dataset.initialized = "true";
    copyButton.addEventListener("click", async () => {
      const email = copyButton.dataset.email;
      const label = copyButton.querySelector<HTMLElement>("[data-copy-label]");
      if (!email || !label) return;

      try {
        await navigator.clipboard.writeText(email);
        copyButton.dataset.copied = "true";
        label.textContent = "Copied";
        window.setTimeout(() => {
          copyButton.dataset.copied = "false";
          label.textContent = "Email";
        }, 2000);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initializeEmailCopy);
  document.addEventListener("astro:after-swap", initializeEmailCopy);
</script>
