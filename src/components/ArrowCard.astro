---
import type { CollectionEntry } from "astro:content";
import DatabasePipeline from "@components/DatabasePipeline.astro";

type Props = {
  entry: CollectionEntry<"projects">;
  index?: number;
  variant?: "featured" | "technical" | "compact";
};

const {
  entry,
  index = entry.data.order + 1,
  variant = "compact",
} = Astro.props;
const projectNumber = String(index).padStart(2, "0");
---

{variant === "technical" ? (
  <a href={`/${entry.collection}/${entry.slug}`} class="technical-project-card">
    <div class="technical-project-copy">
      <span class="project-number">{projectNumber} / {entry.data.technologies.join(" · ")}</span>
      <h3>{entry.data.title}</h3>
      <p>{entry.data.description}</p>
    </div>
    <DatabasePipeline />
  </a>
) : variant === "featured" ? (
  <a href={`/${entry.collection}/${entry.slug}`} class="featured-project-card">
    {entry.data.videoPoster && (
      <div class="project-preview">
        <img src={entry.data.videoPoster} alt="" loading="lazy" />
      </div>
    )}
    <div class="featured-project-meta">
      <span class="project-number">{projectNumber}</span>
      <div>
        <h3>{entry.data.title}</h3>
        <p>{entry.data.description}</p>
      </div>
      <svg class="project-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </div>
  </a>
) : (
  <a href={`/${entry.collection}/${entry.slug}`} class="compact-project-card">
    <span class="project-number">{projectNumber}</span>
    <div>
      <h3>{entry.data.title}</h3>
      <p>{entry.data.description}</p>
    </div>
    <svg class="project-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
  </a>
)}
