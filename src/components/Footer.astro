---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
---

<footer class="site-footer">
  <Container>
    <div class="footer-inner">
      <div>© {new Date().getFullYear()} · {SITE.NAME}</div>
      <div class="footer-actions">
        <button id="back-to-top" class="footer-link" type="button">Back to top ↑</button>
        <div class="theme-controls" aria-label="Color theme">
          <button id="light-theme-button" class="theme-button" type="button" aria-label="Use light theme">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg>
          </button>
          <button id="dark-theme-button" class="theme-button" type="button" aria-label="Use dark theme">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.5 8.5 0 1 0 20.5 14.1Z"></path></svg>
          </button>
          <button id="system-theme-button" class="theme-button" type="button" aria-label="Use system theme">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </Container>
</footer>
